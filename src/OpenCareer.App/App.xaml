<Application
    x:Class="OpenCareer.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B1520" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#111E2B" />
            <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#172737" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="#294156" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="#4EA8DE" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#52D273" />
            <SolidColorBrush x:Key="AppWarningBrush" Color="#D99A32" />
            <SolidColorBrush x:Key="AppDangerBrush" Color="#C94A4A" />
            <SolidColorBrush x:Key="AppMutedTextBrush" Color="#9FB1C2" />

            <SolidColorBrush x:Key="AppPaperBrush" Color="#F4F1E8" />
            <SolidColorBrush x:Key="AppPaperAltBrush" Color="#E8E3D7" />
            <SolidColorBrush x:Key="AppPaperTextBrush" Color="#18232C" />
            <SolidColorBrush x:Key="AppNavyBrush" Color="#263D52" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

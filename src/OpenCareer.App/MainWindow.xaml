<Window
    x:Class="OpenCareer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="OpenCareer">

    <Grid Background="{StaticResource OpenCareerShellBackgroundBrush}" RequestedTheme="Dark">
        <NavigationView
            x:Name="NavView"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="True"
            SelectionChanged="NavView_SelectionChanged"
            Background="{StaticResource OpenCareerShellBackgroundBrush}"
            Foreground="{StaticResource OpenCareerShellTextBrush}">

            <NavigationView.PaneHeader>
                <StackPanel Margin="8,14,8,18" Spacing="2">
                    <TextBlock Text="OPENCAREER" FontSize="24" FontWeight="SemiBold" CharacterSpacing="80" Foreground="{StaticResource OpenCareerShellTextBrush}" />
                    <TextBlock Text="MSFS 2024 Companion" Foreground="{StaticResource OpenCareerShellMutedTextBrush}" FontSize="12" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.Header>
                <Grid Margin="0,4,16,4" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="OPERATIONS" Style="{StaticResource OpenCareerShellSectionTitleStyle}" CharacterSpacing="70" />
                        <TextBlock Text="Career, dispatch and live flight management" Style="{StaticResource OpenCareerShellBodyStyle}" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Style="{StaticResource OpenCareerMetalCardStyle}"
                            Padding="14,8">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Fill="{StaticResource OpenCareerSuccessBrush}" />
                            <StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.AircraftStatus, Mode=OneWay}" Foreground="{StaticResource OpenCareerShellMutedTextBrush}" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </NavigationView.Header>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="DashboardItem" Content="Dashboard" Tag="dashboard" />
                <NavigationViewItem Content="Dispatch" Tag="dispatch" />
                <NavigationViewItem Content="Jobs" Tag="jobs" />
                <NavigationViewItem Content="Current Flight" Tag="current-flight" />
                <NavigationViewItem Content="Map / World" Tag="world" />
                <NavigationViewItem Content="Aircraft" Tag="aircraft" />
                <NavigationViewItem Content="Hangar / Bases" Tag="bases" />
                <NavigationViewItem Content="Maintenance" Tag="maintenance" />
                <NavigationViewItem Content="Company" Tag="company" />
                <NavigationViewItem Content="Finances" Tag="finances" />
                <NavigationViewItem Content="Markets" Tag="markets" />
                <NavigationViewItem Content="Military / Government" Tag="military" />
                <NavigationViewItem Content="Logbook" Tag="logbook" />
                <NavigationViewItem Content="Career" Tag="career" />
                <NavigationViewItem Content="Settings" Tag="settings" />
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <Grid x:Name="TutorialLayer"
              Visibility="Collapsed"
              Background="{StaticResource OpenCareerTutorialScrimBrush}">
            <Border Width="620"
                    MaxHeight="760"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource OpenCareerPaperBrush}"
                    BorderBrush="{StaticResource OpenCareerSteelBorderBrush}"
                    BorderThickness="2"
                    CornerRadius="6"
                    RequestedTheme="Light">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource OpenCareerNavyBrush}"
                            Padding="24,18"
                            CornerRadius="6,6,0,0">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock Text="OPENCAREER FLIGHT SCHOOL"
                                           Foreground="{StaticResource OpenCareerPaperBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           CharacterSpacing="120" />
                                <TextBlock Text="{x:Bind Tutorial.CurrentTitle, Mode=OneWay}"
                                           Foreground="White"
                                           FontSize="26"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind Tutorial.StepPosition, Mode=OneWay}"
                                       Foreground="{StaticResource AppPaperBrush}"
                                       VerticalAlignment="Top"
                                       FontWeight="SemiBold" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  MaxHeight="500"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="26,24" Spacing="18">
                            <TextBlock Text="{x:Bind Tutorial.CurrentBody, Mode=OneWay}"
                                       Foreground="{StaticResource OpenCareerInkBrush}"
                                       FontSize="17"
                                       LineHeight="26"
                                       TextWrapping="Wrap" />

                            <Border Background="{StaticResource OpenCareerPaperAltBrush}"
                                    BorderBrush="{StaticResource OpenCareerPaperRuleBrush}"
                                    BorderThickness="1"
                                    Padding="12,9"
                                    CornerRadius="4"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="FEATURE STATUS"
                                               Foreground="{StaticResource AppPaperTextBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Tutorial.FeatureStateText, Mode=OneWay}"
                                               Foreground="{StaticResource AppPaperTextBrush}"
                                               FontSize="11"
                                               FontWeight="Bold" />
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource OpenCareerPaperAltBrush}"
                                    BorderBrush="{StaticResource OpenCareerPaperRuleBrush}"
                                    BorderThickness="1"
                                    Padding="12,9"
                                    CornerRadius="4"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="LIVE EVIDENCE"
                                               Foreground="{StaticResource AppPaperTextBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Tutorial.EvidenceStateText, Mode=OneWay}"
                                               Foreground="{StaticResource AppPaperTextBrush}"
                                               FontSize="11"
                                               FontWeight="Bold" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="The walkthrough can explain unfinished areas, but it will never pretend a placeholder is usable."
                                       Foreground="{StaticResource OpenCareerInkMutedBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            Background="{StaticResource OpenCareerPaperAltBrush}"
                            BorderBrush="{StaticResource OpenCareerPaperRuleBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="20,14">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Content="Skip tutorial"
                                    Style="{StaticResource OpenCareerSecondaryButtonStyle}"
                                    Click="SkipTutorial_Click" />

                            <Button Grid.Column="2"
                                    Content="Back"
                                    Style="{StaticResource OpenCareerSecondaryButtonStyle}"
                                    IsEnabled="{x:Bind Tutorial.CanGoBack, Mode=OneWay}"
                                    Click="BackTutorial_Click" />

                            <Button x:Name="TutorialNextButton"
                                    Grid.Column="3"
                                    Content="{x:Bind Tutorial.NextButtonText, Mode=OneWay}"
                                    Background="{StaticResource AppNavyBrush}"
                                    Foreground="White"
                                    Click="NextTutorial_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

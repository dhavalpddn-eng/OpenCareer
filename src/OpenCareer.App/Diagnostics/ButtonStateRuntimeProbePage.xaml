<Page
    x:Class="OpenCareer.App.Diagnostics.ButtonStateRuntimeProbePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <!--
            Alias the compiled application palette into the probe's own resource
            scope. Runtime assertions compare against these real resources; no
            test palette is copied into code or XAML.
        -->
        <StaticResource x:Key="ProbeOpenCareerNavyBrush" ResourceKey="OpenCareerNavyBrush" />
        <StaticResource x:Key="ProbeOpenCareerShellTextBrush" ResourceKey="OpenCareerShellTextBrush" />
        <StaticResource x:Key="ProbeOpenCareerSteelBorderBrush" ResourceKey="OpenCareerSteelBorderBrush" />
        <StaticResource x:Key="ProbeOpenCareerNavyRaisedBrush" ResourceKey="OpenCareerNavyRaisedBrush" />
        <StaticResource x:Key="ProbeOpenCareerSteelHighlightBrush" ResourceKey="OpenCareerSteelHighlightBrush" />
        <StaticResource x:Key="ProbeOpenCareerNavyPressedBrush" ResourceKey="OpenCareerNavyPressedBrush" />
        <StaticResource x:Key="ProbeOpenCareerInkMutedBrush" ResourceKey="OpenCareerInkMutedBrush" />
        <StaticResource x:Key="ProbeOpenCareerPaperMutedBrush" ResourceKey="OpenCareerPaperMutedBrush" />
        <StaticResource x:Key="ProbeOpenCareerDisabledBrush" ResourceKey="OpenCareerDisabledBrush" />
        <StaticResource x:Key="ProbeOpenCareerPaperAltBrush" ResourceKey="OpenCareerPaperAltBrush" />
        <StaticResource x:Key="ProbeOpenCareerInkBrush" ResourceKey="OpenCareerInkBrush" />
        <StaticResource x:Key="ProbeOpenCareerPaperRuleBrush" ResourceKey="OpenCareerPaperRuleBrush" />
        <StaticResource x:Key="ProbeOpenCareerSelectionBrush" ResourceKey="OpenCareerSelectionBrush" />
        <StaticResource x:Key="ProbeOpenCareerSecondaryPressedBrush" ResourceKey="OpenCareerSecondaryPressedBrush" />
        <StaticResource x:Key="ProbeOpenCareerDangerBrush" ResourceKey="OpenCareerDangerBrush" />
        <StaticResource x:Key="ProbeOpenCareerDangerRaisedBrush" ResourceKey="OpenCareerDangerRaisedBrush" />
        <StaticResource x:Key="ProbeOpenCareerDangerPressedBrush" ResourceKey="OpenCareerDangerPressedBrush" />
        <StaticResource x:Key="ProbeOpenCareerDangerDisabledBrush" ResourceKey="OpenCareerDangerDisabledBrush" />
    </Page.Resources>

    <Grid Background="{StaticResource OpenCareerShellBackgroundBrush}"
          Padding="32">
        <Border Background="{StaticResource OpenCareerPaperBrush}"
                BorderBrush="{StaticResource OpenCareerPaperRuleBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RequestedTheme="Light">
            <StackPanel Spacing="16">
                <TextBlock Text="DEVELOPMENT / TEST — BUTTON STATE PROBE"
                           Style="{StaticResource OpenCareerPaperTitleStyle}" />
                <TextBlock Text="These are real OpenCareer buttons using the compiled App resources and stock WinUI template."
                           Style="{StaticResource OpenCareerPaperBodyStyle}"
                           TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal"
                            Spacing="12">
                    <Button x:Name="PrimaryProbeButton"
                            Content="Primary — hover and press"
                            Style="{StaticResource OpenCareerPrimaryButtonStyle}" />
                    <Button x:Name="SecondaryProbeButton"
                            Content="Secondary — hover and press"
                            Style="{StaticResource OpenCareerSecondaryButtonStyle}" />
                    <Button x:Name="DangerProbeButton"
                            Content="Danger — hover and press"
                            Style="{StaticResource OpenCareerDangerButtonStyle}" />
                </StackPanel>

                <ToggleSwitch x:Name="DisabledToggle"
                              Header="Visual state"
                              OffContent="Enabled"
                              OnContent="Disabled"
                              Toggled="DisabledToggle_Toggled"
                              Style="{StaticResource OpenCareerToggleSwitchStyle}" />

                <TextBlock x:Name="ProbeStatusText"
                           Text="Runtime certification pending."
                           Style="{StaticResource OpenCareerPaperBodyStyle}"
                           TextWrapping="Wrap" />

                <Button x:Name="StockLightProbeButton"
                        Content="Stock light template reference"
                        Style="{StaticResource DefaultButtonStyle}"
                        RequestedTheme="Light"
                        Opacity="0"
                        IsHitTestVisible="False"
                        IsTabStop="False"
                        AutomationProperties.AccessibilityView="Raw"
                        Width="1"
                        Height="1" />
                <Button x:Name="StockDarkProbeButton"
                        Content="Stock dark template reference"
                        Style="{StaticResource DefaultButtonStyle}"
                        RequestedTheme="Dark"
                        Opacity="0"
                        IsHitTestVisible="False"
                        IsTabStop="False"
                        AutomationProperties.AccessibilityView="Raw"
                        Width="1"
                        Height="1" />
            </StackPanel>
        </Border>
    </Grid>
</Page>

<Page
    x:Class="OpenCareer.App.Diagnostics.ButtonStateRuntimeProbePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        DIAGNOSTIC BISECTION GROUP A.
        All named probe controls are deferred with x:Load=False so the generated
        fields remain compilable while isolating Page + empty Grid loading.
    -->
    <Grid>
        <StackPanel>
            <Button x:Name="PrimaryProbeButton" x:Load="False" />
            <Button x:Name="SecondaryProbeButton" x:Load="False" />
            <Button x:Name="DangerProbeButton" x:Load="False" />
            <ToggleSwitch x:Name="DisabledToggle" x:Load="False" />
            <TextBlock x:Name="ProbeStatusText" x:Load="False" />
            <Button x:Name="StockLightProbeButton" x:Load="False" />
            <Button x:Name="StockDarkProbeButton" x:Load="False" />
        </StackPanel>
    </Grid>
</Page>

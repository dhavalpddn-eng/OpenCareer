<Page
    x:Class="OpenCareer.App.Diagnostics.ButtonStateRuntimeProbePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        DIAGNOSTIC BISECTION GROUP A.
        Resource-free controls retain generated fields required by the existing
        probe code while isolating compiled Page/control construction.
    -->
    <Grid>
        <StackPanel>
            <Button x:Name="PrimaryProbeButton" />
            <Button x:Name="SecondaryProbeButton" />
            <Button x:Name="DangerProbeButton" />
            <ToggleSwitch x:Name="DisabledToggle" />
            <TextBlock x:Name="ProbeStatusText" />
            <Button x:Name="StockLightProbeButton" />
            <Button x:Name="StockDarkProbeButton" />
        </StackPanel>
    </Grid>
</Page>

<Page
    x:Class="OpenCareer.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Margin="32" Spacing="20" MaxWidth="920" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="Settings"
                           Style="{StaticResource OpenCareerPageTitleStyle}" />
                <TextBlock Text="Application preferences and recovery tools."
                           Style="{StaticResource OpenCareerPageSubtitleStyle}" />
            </StackPanel>

            <Border Style="{StaticResource OpenCareerPaperCardStyle}"
                    Padding="22">
                <StackPanel Spacing="12">
                    <TextBlock Text="TRAINING &amp; TUTORIALS"
                               Style="{StaticResource OpenCareerPaperEyebrowStyle}" />
                    <TextBlock Text="Intro tutorial"
                               Style="{StaticResource OpenCareerPaperTitleStyle}" />
                    <TextBlock Text="Replay the full OpenCareer application walkthrough. Restarting the tutorial does not change career progress, money, flights, aircraft or qualifications."
                               Style="{StaticResource OpenCareerPaperBodyStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Restart intro tutorial"
                                Style="{StaticResource OpenCareerPrimaryButtonStyle}"
                                Click="RestartIntro_Click" />
                        <Button Content="Preview first-job walkthrough"
                                Style="{StaticResource OpenCareerSecondaryButtonStyle}"
                                Click="StartFirstJob_Click" />
                    </StackPanel>
                    <TextBlock Text="The first-job walkthrough is available for preview now. Job and Dispatch steps remain labeled Coming Later until those systems are implemented."
                               FontSize="12"
                               Style="{StaticResource OpenCareerPaperBodyStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OpenCareerPaperCardStyle}"
                    Padding="22">
                <StackPanel Spacing="12">
                    <TextBlock Text="SPECIAL MISSION TUTORIAL PREVIEWS"
                               Style="{StaticResource OpenCareerPaperEyebrowStyle}" />
                    <TextBlock Text="Preview unique procedures"
                               Style="{StaticResource OpenCareerPaperTitleStyle}" />
                    <TextBlock Text="These walkthroughs are usable as training previews now. Their real mission triggers, live objective validation and checklist evidence arrive with the corresponding mission systems."
                               Style="{StaticResource OpenCareerPaperBodyStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Banner tow"
                                Style="{StaticResource OpenCareerPrimaryButtonStyle}"
                                Click="PreviewBannerTow_Click" />
                        <Button Content="Carrier takeoff"
                                Style="{StaticResource OpenCareerSecondaryButtonStyle}"
                                Click="PreviewCarrierTakeoff_Click" />
                        <Button Content="Carrier landing"
                                Style="{StaticResource OpenCareerSecondaryButtonStyle}"
                                Click="PreviewCarrierLanding_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OpenCareerPaperCardStyle}"
                    Padding="22">
                <StackPanel Spacing="8">
                    <TextBlock Text="SIMULATOR"
                               Style="{StaticResource OpenCareerPaperEyebrowStyle}" />
                    <TextBlock Text="Detailed connection diagnostics and input/checklist preferences will be added as their production systems are implemented."
                               Style="{StaticResource OpenCareerPaperBodyStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

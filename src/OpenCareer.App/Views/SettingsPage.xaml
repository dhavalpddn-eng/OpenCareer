<Page
    x:Class="OpenCareer.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Margin="32" Spacing="20" MaxWidth="920" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Application preferences and recovery tools."
                           Foreground="{StaticResource AppMutedTextBrush}" />
            </StackPanel>

            <Border Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22">
                <StackPanel Spacing="12">
                    <TextBlock Text="TRAINING &amp; TUTORIALS"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppMutedTextBrush}" />
                    <TextBlock Text="Intro tutorial"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Replay the full OpenCareer application walkthrough. Restarting the tutorial does not change career progress, money, flights, aircraft or qualifications."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource AppMutedTextBrush}" />
                    <Button Content="Restart intro tutorial"
                            HorizontalAlignment="Left"
                            Click="RestartIntro_Click" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22">
                <StackPanel Spacing="8">
                    <TextBlock Text="SIMULATOR"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppMutedTextBrush}" />
                    <TextBlock Text="Detailed connection diagnostics and input/checklist preferences will be added as their production systems are implemented."
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

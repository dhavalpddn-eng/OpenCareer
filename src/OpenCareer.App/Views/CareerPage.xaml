<Page
    x:Class="OpenCareer.App.Views.CareerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Margin="28"
                    Spacing="18"
                    MaxWidth="760"
                    HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="CAREER"
                           Style="{StaticResource OpenCareerPageTitleStyle}" />
                <TextBlock Text="Create the persistent civilian career profile used by local jobs, travel and progression."
                           Style="{StaticResource OpenCareerPageSubtitleStyle}" />
            </StackPanel>

            <Border Style="{StaticResource OpenCareerPaperCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="CAREER ONBOARDING"
                               Style="{StaticResource OpenCareerPaperEyebrowStyle}" />
                    <TextBlock Text="{Binding StatusText}"
                               Style="{StaticResource OpenCareerPaperTitleStyle}" />
                    <TextBlock Text="{Binding LocationText}"
                               Style="{StaticResource OpenCareerPaperBodyStyle}" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="STARTING AIRPORT ICAO"
                                   Style="{StaticResource OpenCareerInputLabelStyle}" />
                        <TextBox x:Name="HomeAirportTextBox"
                                 Text="{Binding HomeAirportIcao, Mode=OneWay}"
                                 PlaceholderText="KDFW"
                                 MaxLength="4"
                                 IsEnabled="{Binding CanEditHomeAirport}"
                                 TextChanged="HomeAirportTextBox_TextChanged"
                                 Style="{StaticResource OpenCareerTextBoxStyle}" />
                        <TextBlock Text="Use the four-letter ICAO of the airport where your first local job board should be created."
                                   Style="{StaticResource OpenCareerInputHelpStyle}" />
                    </StackPanel>

                    <Button Content="{Binding StartButtonText}"
                            IsEnabled="{Binding CanStartCareer}"
                            Click="StartCareer_Click"
                            HorizontalAlignment="Left"
                            Style="{StaticResource OpenCareerPrimaryButtonStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OpenCareerPaperCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="STUDENT TRAINING"
                               Style="{StaticResource OpenCareerPaperEyebrowStyle}" />
                    <TextBlock Text="First Solo Circuit"
                               Style="{StaticResource OpenCareerPaperTitleStyle}" />
                    <TextBlock Text="Fly one local circuit with an authoritative takeoff, full-stop landing, parking and shutdown. Completion is verified from the FlightSession; this screen cannot grant a qualification."
                               Style="{StaticResource OpenCareerPaperBodyStyle}"
                               TextWrapping="Wrap" />
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="ROUTE"
                                       Style="{StaticResource OpenCareerPaperDataLabelStyle}" />
                            <TextBlock Text="{Binding StudentTrainingRouteText}"
                                       Style="{StaticResource OpenCareerPaperDataValueStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="AIRCRAFT"
                                       Style="{StaticResource OpenCareerPaperDataLabelStyle}" />
                            <TextBlock Text="{Binding StudentTrainingAircraftText}"
                                       Style="{StaticResource OpenCareerPaperDataValueStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding StudentTrainingStatusText}"
                               Style="{StaticResource OpenCareerInputHelpStyle}"
                               TextWrapping="Wrap" />
                    <Button Content="{Binding StudentTrainingButtonText}"
                            IsEnabled="{Binding CanStartStudentTraining}"
                            Click="StartStudentTraining_Click"
                            HorizontalAlignment="Left"
                            Style="{StaticResource OpenCareerPrimaryButtonStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OpenCareerPaperCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="CIVILIAN QUALIFICATIONS"
                               Style="{StaticResource OpenCareerPaperEyebrowStyle}" />
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="CURRENT LICENSE"
                                       Style="{StaticResource OpenCareerPaperDataLabelStyle}" />
                            <TextBlock Text="{Binding CurrentLicenseText}"
                                       Style="{StaticResource OpenCareerPaperDataValueStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="EARNED RATINGS"
                                       Style="{StaticResource OpenCareerPaperDataLabelStyle}" />
                            <TextBlock Text="{Binding EarnedRatingsText}"
                                       Style="{StaticResource OpenCareerPaperDataValueStyle}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding NextQualificationsText}"
                               Style="{StaticResource OpenCareerPaperBodyStyle}" />
                    <TextBlock Text="{Binding QualificationPolicyText}"
                               Style="{StaticResource OpenCareerInputHelpStyle}" />

                    <ItemsControl ItemsSource="{Binding QualificationRoadmapItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Style="{StaticResource OpenCareerPaperInsetStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding Status}"
                                                       Style="{StaticResource OpenCareerPaperDataValueStyle}" />
                                            <TextBlock Text="{Binding Kind}"
                                                       Style="{StaticResource OpenCareerPaperDataLabelStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{Binding Title}"
                                                       Style="{StaticResource OpenCareerPaperDataValueStyle}" />
                                            <TextBlock Text="{Binding Description}"
                                                       Style="{StaticResource OpenCareerPaperBodyStyle}" />
                                            <TextBlock Text="{Binding Prerequisites}"
                                                       Style="{StaticResource OpenCareerInputHelpStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

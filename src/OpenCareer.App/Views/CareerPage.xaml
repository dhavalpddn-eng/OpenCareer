<Page
    x:Class="OpenCareer.App.Views.CareerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Margin="28"
                    Spacing="18"
                    MaxWidth="760"
                    HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="CAREER"
                           Style="{StaticResource OpenCareerPageTitleStyle}" />
                <TextBlock Text="Create the persistent civilian career profile used by local jobs, travel and progression."
                           Style="{StaticResource OpenCareerPageSubtitleStyle}" />
            </StackPanel>

            <Border Style="{StaticResource OpenCareerPaperCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="CAREER ONBOARDING"
                               Style="{StaticResource OpenCareerPaperEyebrowStyle}" />
                    <TextBlock Text="{Binding StatusText}"
                               Style="{StaticResource OpenCareerPaperTitleStyle}" />
                    <TextBlock Text="{Binding LocationText}"
                               Style="{StaticResource OpenCareerPaperBodyStyle}" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="STARTING AIRPORT ICAO"
                                   Style="{StaticResource OpenCareerInputLabelStyle}" />
                        <TextBox x:Name="HomeAirportTextBox"
                                 Text="{Binding HomeAirportIcao, Mode=OneWay}"
                                 PlaceholderText="KDFW"
                                 MaxLength="4"
                                 IsEnabled="{Binding CanEditHomeAirport}"
                                 TextChanged="HomeAirportTextBox_TextChanged"
                                 Style="{StaticResource OpenCareerTextBoxStyle}" />
                        <TextBlock Text="Use the four-letter ICAO of the airport where your first local job board should be created."
                                   Style="{StaticResource OpenCareerInputHelpStyle}" />
                    </StackPanel>

                    <Button Content="{Binding StartButtonText}"
                            IsEnabled="{Binding CanStartCareer}"
                            Click="StartCareer_Click"
                            HorizontalAlignment="Left"
                            Style="{StaticResource OpenCareerPrimaryButtonStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

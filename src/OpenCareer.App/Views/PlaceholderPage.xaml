<Page
    x:Class="OpenCareer.App.Views.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Border Style="{StaticResource OpenCareerPaperCardStyle}"
                MaxWidth="620"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="28">
            <StackPanel Spacing="10">
                <TextBlock Text="SECTION"
                           Style="{StaticResource OpenCareerPaperEyebrowStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="SectionTitle"
                           Style="{StaticResource OpenCareerPaperValueStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="This section is intentionally reserved for a later chapter."
                           Style="{StaticResource OpenCareerPaperBodyStyle}"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Page>

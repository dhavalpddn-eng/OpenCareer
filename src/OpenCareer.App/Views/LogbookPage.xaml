<Page
    x:Class="OpenCareer.App.Views.LogbookPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Margin="32" Spacing="20" MaxWidth="1440">
            <StackPanel Spacing="4">
                <TextBlock Text="LOGBOOK / DEBRIEF"
                           Style="{StaticResource OpenCareerPageTitleStyle}" />
                <TextBlock Text="Committed flight history with frozen postflight facts, evidence and settlement references. OpenCareer is not a certified legal logbook."
                           Style="{StaticResource OpenCareerPageSubtitleStyle}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Style="{StaticResource OpenCareerPaperCardStyle}" Padding="20">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="HISTORY STATUS"
                                   Style="{StaticResource OpenCareerPaperEyebrowStyle}" />
                        <TextBlock Text="{Binding StatusText}"
                                   Style="{StaticResource OpenCareerPaperBodyStyle}" />
                    </StackPanel>

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource OpenCareerPaperInsetStyle}">
                            <StackPanel Spacing="3">
                                <TextBlock Text="FLIGHT TIME"
                                           Style="{StaticResource OpenCareerPaperDataLabelStyle}" />
                                <TextBlock Text="{Binding TotalFlightTimeText}"
                                           Style="{StaticResource OpenCareerPaperValueStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Style="{StaticResource OpenCareerPaperInsetStyle}">
                            <StackPanel Spacing="3">
                                <TextBlock Text="CAREER CREDIT"
                                           Style="{StaticResource OpenCareerPaperDataLabelStyle}" />
                                <TextBlock Text="{Binding CareerCreditText}"
                                           Style="{StaticResource OpenCareerPaperValueStyle}" />
                                <TextBlock Text="{Binding ExperienceDimensionsText}"
                                           Style="{StaticResource OpenCareerPaperDataLabelStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource OpenCareerPaperInsetStyle}">
                            <StackPanel Spacing="3">
                                <TextBlock Text="OPERATIONS"
                                           Style="{StaticResource OpenCareerPaperDataLabelStyle}" />
                                <TextBlock Text="{Binding OperationsCountText}"
                                           Style="{StaticResource OpenCareerPaperValueStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3"
                                Style="{StaticResource OpenCareerPaperInsetStyle}">
                            <StackPanel Spacing="3">
                                <TextBlock Text="LANDING TYPES"
                                           Style="{StaticResource OpenCareerPaperDataLabelStyle}" />
                                <TextBlock Text="{Binding LandingTypeCountText}"
                                           Style="{StaticResource OpenCareerPaperBodyStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource OpenCareerPaperCardStyle}" Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock Text="COMMITTED FLIGHTS"
                                   Style="{StaticResource OpenCareerPaperEyebrowStyle}" />
                        <ListView x:Name="EntryList"
                                  ItemsSource="{Binding Entries}"
                                  Style="{StaticResource OpenCareerListViewStyle}"
                                  SelectionChanged="EntryList_SelectionChanged">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem"
                                       BasedOn="{StaticResource OpenCareerListViewItemStyle}" />
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource OpenCareerTableRowStyle}">
                                        <StackPanel Spacing="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Route}"
                                                           Style="{StaticResource OpenCareerTableCellTextStyle}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding FlightTime}"
                                                           Style="{StaticResource OpenCareerPaperDataValueStyle}" />
                                            </Grid>
                                            <TextBlock Text="{Binding Aircraft}"
                                                       Style="{StaticResource OpenCareerPaperDataLabelStyle}" />
                                            <TextBlock Text="{Binding Date}"
                                                       Style="{StaticResource OpenCareerPaperDataLabelStyle}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource OpenCareerPaperCardStyle}"
                        Padding="22">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="3">
                            <TextBlock Text="POSTFLIGHT DEBRIEF"
                                       Style="{StaticResource OpenCareerPaperEyebrowStyle}" />
                            <TextBlock Text="{Binding SelectedTitle}"
                                       Style="{StaticResource OpenCareerPaperTitleStyle}" />
                            <TextBlock Text="{Binding SelectedSubtitle}"
                                       Style="{StaticResource OpenCareerPaperBodyStyle}" />
                        </StackPanel>

                        <Border Style="{StaticResource OpenCareerPaperInsetStyle}">
                            <StackPanel Spacing="5">
                                <TextBlock Text="TIME"
                                           Style="{StaticResource OpenCareerPaperDataLabelStyle}" />
                                <TextBlock Text="{Binding SelectedTimeSummary}"
                                           Style="{StaticResource OpenCareerPaperDataValueStyle}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedExperienceSummary}"
                                           Style="{StaticResource OpenCareerPaperBodyStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource OpenCareerPaperInsetStyle}">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="OUTCOME"
                                               Style="{StaticResource OpenCareerPaperDataLabelStyle}" />
                                    <TextBlock Text="{Binding SelectedOutcomeSummary}"
                                               Style="{StaticResource OpenCareerPaperDataValueStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Style="{StaticResource OpenCareerPaperInsetStyle}">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="SETTLEMENT"
                                               Style="{StaticResource OpenCareerPaperDataLabelStyle}" />
                                    <TextBlock Text="{Binding SelectedSettlementSummary}"
                                               Style="{StaticResource OpenCareerPaperDataValueStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource OpenCareerPaperInsetStyle}">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="FUEL / PAYLOAD"
                                               Style="{StaticResource OpenCareerPaperDataLabelStyle}" />
                                    <TextBlock Text="{Binding SelectedFuelSummary}"
                                               Style="{StaticResource OpenCareerPaperBodyStyle}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SelectedPayloadSummary}"
                                               Style="{StaticResource OpenCareerPaperDataLabelStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Style="{StaticResource OpenCareerPaperInsetStyle}">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="ASSISTANCE / ROUTE INTEGRITY"
                                               Style="{StaticResource OpenCareerPaperDataLabelStyle}" />
                                    <TextBlock Text="{Binding SelectedAssistanceSummary}"
                                               Style="{StaticResource OpenCareerPaperBodyStyle}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SelectedLegSummary}"
                                               Style="{StaticResource OpenCareerPaperDataLabelStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource OpenCareerPaperInsetStyle}">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="LANDING / HANDLING"
                                               Style="{StaticResource OpenCareerPaperDataLabelStyle}" />
                                    <TextBlock Text="{Binding SelectedLandingSummary}"
                                               Style="{StaticResource OpenCareerPaperBodyStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Style="{StaticResource OpenCareerPaperInsetStyle}">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="EVENTS / INCIDENTS"
                                               Style="{StaticResource OpenCareerPaperDataLabelStyle}" />
                                    <TextBlock Text="{Binding SelectedEventSummary}"
                                               Style="{StaticResource OpenCareerPaperBodyStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Spacing="8">
                            <TextBlock Text="FLIGHT LEGS"
                                       Style="{StaticResource OpenCareerPaperEyebrowStyle}" />
                            <ItemsControl ItemsSource="{Binding SelectedLegs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource OpenCareerPaperRuleBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,8">
                                            <Grid ColumnSpacing="14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="1.4*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Sequence}"
                                                           Style="{StaticResource OpenCareerPaperDataLabelStyle}" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{Binding Route}"
                                                               Style="{StaticResource OpenCareerTableCellTextStyle}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Time}"
                                                               Style="{StaticResource OpenCareerPaperDataLabelStyle}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="2">
                                                    <TextBlock Text="{Binding Track}"
                                                               Style="{StaticResource OpenCareerPaperDataLabelStyle}" />
                                                    <TextBlock Text="{Binding LandingReferences}"
                                                               Style="{StaticResource OpenCareerPaperDataLabelStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="LANDING EPISODES"
                                       Style="{StaticResource OpenCareerPaperEyebrowStyle}" />
                            <ItemsControl ItemsSource="{Binding SelectedLandings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource OpenCareerPaperRuleBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,8">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Title}"
                                                           Style="{StaticResource OpenCareerTableCellTextStyle}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Metrics}"
                                                           Style="{StaticResource OpenCareerPaperBodyStyle}" />
                                                <TextBlock Text="{Binding Bounces}"
                                                           Style="{StaticResource OpenCareerPaperDataLabelStyle}" />
                                                <TextBlock Text="{Binding HardLanding}"
                                                           Style="{StaticResource OpenCareerPaperDataLabelStyle}" />
                                                <TextBlock Text="{Binding Evidence}"
                                                           Style="{StaticResource OpenCareerPaperDataLabelStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="EVENTS / INCIDENTS"
                                       Style="{StaticResource OpenCareerPaperEyebrowStyle}" />
                            <ItemsControl ItemsSource="{Binding SelectedEvents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource OpenCareerPaperRuleBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,8">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="170" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Category}"
                                                               Style="{StaticResource OpenCareerPaperDataLabelStyle}" />
                                                    <TextBlock Text="{Binding Severity}"
                                                               Style="{StaticResource OpenCareerTableCellTextStyle}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Text}"
                                                           Style="{StaticResource OpenCareerPaperBodyStyle}"
                                                           TextWrapping="Wrap" />
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding When}"
                                                               Style="{StaticResource OpenCareerPaperDataLabelStyle}" />
                                                    <TextBlock Text="{Binding Evidence}"
                                                               Style="{StaticResource OpenCareerPaperDataLabelStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Text="Historical entries are frozen snapshots. Later tuning changes do not rewrite completed flight outcomes, evidence, or settlement references."
                                   Style="{StaticResource OpenCareerPaperBodyStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>

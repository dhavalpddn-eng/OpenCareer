<Page
    x:Class="OpenCareer.App.Views.DispatchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28"
                    Spacing="18"
                    MaxWidth="960"
                    HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="DISPATCH"
                           Style="{StaticResource OpenCareerPageTitleStyle}" />
                <TextBlock Text="Evaluate explicit dispatch inputs or persist one feasible plan for the exact accepted job. This workspace does not accept jobs, reserve aircraft or start flights."
                           Style="{StaticResource OpenCareerPageSubtitleStyle}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Style="{StaticResource OpenCareerPaperCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="AIRCRAFT AND ROUTE"
                               Style="{StaticResource OpenCareerPaperEyebrowStyle}" />
                    <ComboBox x:Name="AircraftPicker"
                              Header="Installed aircraft"
                              ItemsSource="{Binding AircraftOptions}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="AircraftId"
                              SelectionChanged="AircraftSelection_Changed"
                              HorizontalAlignment="Stretch"
                              Style="{StaticResource OpenCareerComboBoxStyle}" />
                    <TextBlock Text="{Binding InventoryStatus}"
                               Style="{StaticResource OpenCareerInputHelpStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding AcceptedContextText}"
                               Style="{StaticResource OpenCareerPaperBodyStyle}"
                               TextWrapping="Wrap" />
                    <Button Content="{Binding CancelAcceptedJobButtonText}"
                            IsEnabled="{Binding CanCancelAcceptedJob}"
                            Click="CancelAcceptedJob_Click"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource OpenCareerDangerButtonStyle}" />

                    <Grid ColumnSpacing="14" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="OriginIcaoBox"
                                 Header="Origin ICAO"
                                 MaxLength="4"
                                 IsReadOnly="{Binding IsAcceptedContextLocked}"
                                 Style="{StaticResource OpenCareerTextBoxStyle}" />
                        <TextBox x:Name="DestinationIcaoBox"
                                 Grid.Column="1"
                                 Header="Destination ICAO"
                                 MaxLength="4"
                                 IsReadOnly="{Binding IsAcceptedContextLocked}"
                                 Style="{StaticResource OpenCareerTextBoxStyle}" />
                        <TextBox x:Name="PayloadPoundsBox"
                                 Grid.Row="1"
                                 Header="Payload (lb)"
                                 InputScope="Number"
                                 IsReadOnly="{Binding IsAcceptedContextLocked}"
                                 Style="{StaticResource OpenCareerTextBoxStyle}" />
                        <TextBox x:Name="TotalRouteDistanceBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Header="Total route distance (nm)"
                                 InputScope="Number"
                                 IsReadOnly="{Binding IsAcceptedContextLocked}"
                                 Style="{StaticResource OpenCareerTextBoxStyle}" />
                        <TextBox x:Name="RangeSafetyMarginBox"
                                 Grid.Row="2"
                                 Header="Range safety margin (%)"
                                 InputScope="Number"
                                 Style="{StaticResource OpenCareerTextBoxStyle}" />
                        <TextBox x:Name="RunwaySafetyMarginBox"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 Header="Runway safety margin (%)"
                                 InputScope="Number"
                                 Style="{StaticResource OpenCareerTextBoxStyle}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OpenCareerPaperCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="WEATHER LIMITS"
                               Style="{StaticResource OpenCareerPaperEyebrowStyle}" />
                    <CheckBox x:Name="ApplyWeatherLimitsCheckBox"
                              Content="Evaluate explicit weather limits"
                              Style="{StaticResource OpenCareerCheckBoxStyle}" />
                    <TextBlock Text="When enabled, the existing dispatch weather source must provide enough authoritative airport/runway evidence. Blank optional limits remain unconstrained; no hidden defaults are applied."
                               Style="{StaticResource OpenCareerInputHelpStyle}"
                               TextWrapping="Wrap" />
                    <Grid ColumnSpacing="14" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="MaximumCrosswindBox"
                                 Header="Maximum crosswind (kt)"
                                 InputScope="Number"
                                 Style="{StaticResource OpenCareerTextBoxStyle}" />
                        <TextBox x:Name="MaximumTailwindBox"
                                 Grid.Column="1"
                                 Header="Maximum tailwind (kt)"
                                 InputScope="Number"
                                 Style="{StaticResource OpenCareerTextBoxStyle}" />
                        <TextBox x:Name="MaximumDensityAltitudeBox"
                                 Grid.Column="2"
                                 Header="Maximum density altitude (ft, optional)"
                                 InputScope="Number"
                                 Style="{StaticResource OpenCareerTextBoxStyle}" />
                        <TextBox x:Name="MinimumVisibilityBox"
                                 Grid.Row="1"
                                 Header="Minimum visibility (sm, optional)"
                                 InputScope="Number"
                                 Style="{StaticResource OpenCareerTextBoxStyle}" />
                        <TextBox x:Name="MinimumCeilingBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Header="Minimum ceiling (ft AGL, optional)"
                                 InputScope="Number"
                                 Style="{StaticResource OpenCareerTextBoxStyle}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OpenCareerPaperCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="CRUISE PERFORMANCE EVIDENCE"
                               Style="{StaticResource OpenCareerPaperEyebrowStyle}" />
                    <TextBlock Text="Choose only from complete cruise profiles proven by the selected aircraft's registry evidence. OpenCareer does not guess an index, choose a profile, or extrapolate outside its data envelope."
                               Style="{StaticResource OpenCareerInputHelpStyle}"
                               TextWrapping="Wrap" />
                    <ComboBox x:Name="CruiseProfilePicker"
                              Header="Authoritative cruise profile"
                              ItemsSource="{Binding CruiseProfileOptions}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="ProfileIndex"
                              SelectionChanged="CruiseProfileSelection_Changed"
                              HorizontalAlignment="Stretch"
                              Style="{StaticResource OpenCareerComboBoxStyle}" />
                    <TextBlock Text="{Binding CruiseProfileStatus}"
                               Style="{StaticResource OpenCareerInputHelpStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedCruiseProfileEvidence}"
                               Style="{StaticResource OpenCareerPaperDataValueStyle}"
                               TextWrapping="Wrap" />
                    <Grid ColumnSpacing="14" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="CruiseWeightBox"
                                 Header="Cruise weight (lb)"
                                 InputScope="Number"
                                 Style="{StaticResource OpenCareerTextBoxStyle}" />
                        <TextBox x:Name="IsaDeviationBox"
                                 Grid.Column="1"
                                 Header="ISA deviation (°C)"
                                 InputScope="Number"
                                 Style="{StaticResource OpenCareerTextBoxStyle}" />
                        <TextBox x:Name="PressureAltitudeBox"
                                 Grid.Column="2"
                                 Header="Pressure altitude (ft)"
                                 InputScope="Number"
                                 Style="{StaticResource OpenCareerTextBoxStyle}" />
                        <TextBox x:Name="CruiseSegmentDistanceBox"
                                 Grid.Row="1"
                                 Header="Cruise segment (nm)"
                                 InputScope="Number"
                                 Style="{StaticResource OpenCareerTextBoxStyle}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OpenCareerPaperCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="FUEL AND RESERVES"
                               Style="{StaticResource OpenCareerPaperEyebrowStyle}" />
                    <TextBlock Text="Climb/descent values and reserve policy are explicit inputs. They are never synthesized from cruise data."
                               Style="{StaticResource OpenCareerInputHelpStyle}"
                               TextWrapping="Wrap" />
                    <Grid ColumnSpacing="14" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="ClimbTimeBox"
                                 Header="Climb time (min)"
                                 InputScope="Number"
                                 Style="{StaticResource OpenCareerTextBoxStyle}" />
                        <TextBox x:Name="DescentTimeBox"
                                 Grid.Column="1"
                                 Header="Descent time (min)"
                                 InputScope="Number"
                                 Style="{StaticResource OpenCareerTextBoxStyle}" />
                        <TextBox x:Name="ContingencyPercentBox"
                                 Grid.Column="2"
                                 Header="Contingency fuel (%)"
                                 InputScope="Number"
                                 Style="{StaticResource OpenCareerTextBoxStyle}" />
                        <TextBox x:Name="ClimbFuelBox"
                                 Grid.Row="1"
                                 Header="Climb fuel (gal)"
                                 InputScope="Number"
                                 Style="{StaticResource OpenCareerTextBoxStyle}" />
                        <TextBox x:Name="DescentFuelBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Header="Descent fuel (gal)"
                                 InputScope="Number"
                                 Style="{StaticResource OpenCareerTextBoxStyle}" />
                        <TextBox x:Name="FinalReserveMinutesBox"
                                 Grid.Row="1"
                                 Grid.Column="2"
                                 Header="Final reserve (min)"
                                 InputScope="Number"
                                 Style="{StaticResource OpenCareerTextBoxStyle}" />
                        <TextBox x:Name="AdditionalReserveFuelBox"
                                 Grid.Row="2"
                                 Header="Additional reserve (gal)"
                                 InputScope="Number"
                                 Style="{StaticResource OpenCareerTextBoxStyle}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal"
                                Spacing="10">
                        <Button Content="{Binding EvaluateButtonText}"
                                IsEnabled="{Binding CanEvaluate}"
                                Click="EvaluatePlan_Click"
                                Style="{StaticResource OpenCareerSecondaryButtonStyle}" />
                        <Button Content="{Binding PrepareButtonText}"
                                IsEnabled="{Binding CanPrepare}"
                                Click="PreparePlan_Click"
                                Style="{StaticResource OpenCareerPrimaryButtonStyle}" />
                    </StackPanel>

                    <Border Style="{StaticResource OpenCareerPaperInsetStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="PERSISTED PREPARATION"
                                       Style="{StaticResource OpenCareerPaperEyebrowStyle}" />
                            <TextBlock Text="{Binding PreparationStatus}"
                                       Style="{StaticResource OpenCareerPaperDataValueStyle}" />
                            <TextBlock Text="{Binding PreparationDetail}"
                                       Style="{StaticResource OpenCareerInputHelpStyle}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PreparationSummary}"
                                       Style="{StaticResource OpenCareerPaperDataValueStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OpenCareerPaperCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="DISPATCH RESULT"
                               Style="{StaticResource OpenCareerPaperEyebrowStyle}" />
                    <TextBlock Text="{Binding ResultStatus}"
                               Style="{StaticResource OpenCareerPaperTitleStyle}" />
                    <TextBlock Text="{Binding ResultDetail}"
                               Style="{StaticResource OpenCareerPaperBodyStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding FuelSummary}"
                               Style="{StaticResource OpenCareerPaperDataValueStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding RunwaySummary}"
                               Style="{StaticResource OpenCareerPaperDataValueStyle}"
                               TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Issues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Style="{StaticResource OpenCareerPaperInsetStyle}">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding Reason}"
                                                   Style="{StaticResource OpenCareerPaperDataValueStyle}" />
                                        <TextBlock Text="{Binding Detail}"
                                                   Style="{StaticResource OpenCareerInputHelpStyle}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

<Page
    x:Class="OpenCareer.App.Views.CurrentFlightPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel MaxWidth="900"
                    Margin="32"
                    Spacing="18"
                    HorizontalAlignment="Center">
            <TextBlock Text="No active flight" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ConnectionStatus}"
                       Foreground="{StaticResource AppAccentBrush}"
                       FontWeight="SemiBold" />
            <TextBlock Text="Live simulator telemetry is shown below when available. OpenCareer does not create or claim a FlightSession from connection or telemetry alone."
                       Foreground="{StaticResource AppMutedTextBrush}"
                       TextWrapping="Wrap" />

            <Border Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Aircraft telemetry" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AircraftStatus}"
                                   Foreground="{StaticResource AppMutedTextBrush}" />
                    </StackPanel>

                    <Grid ColumnSpacing="24" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3">
                            <TextBlock Text="Position" Foreground="{StaticResource AppMutedTextBrush}" />
                            <TextBlock Text="{Binding PositionSummary}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="3">
                            <TextBlock Text="Altitude" Foreground="{StaticResource AppMutedTextBrush}" />
                            <TextBlock Text="{Binding AltitudeSummary}" FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="3">
                            <TextBlock Text="Speed" Foreground="{StaticResource AppMutedTextBrush}" />
                            <TextBlock Text="{Binding SpeedSummary}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                            <TextBlock Text="Vertical speed" Foreground="{StaticResource AppMutedTextBrush}" />
                            <TextBlock Text="{Binding VerticalSpeedSummary}" FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Spacing="3">
                            <TextBlock Text="Heading" Foreground="{StaticResource AppMutedTextBrush}" />
                            <TextBlock Text="{Binding HeadingSummary}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="3">
                            <TextBlock Text="Aircraft state" Foreground="{StaticResource AppMutedTextBrush}" />
                            <TextBlock Text="{Binding AircraftStateSummary}" FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="3">
                            <TextBlock Text="Attitude / load factor" Foreground="{StaticResource AppMutedTextBrush}" />
                            <TextBlock Text="{Binding AttitudeSummary}" FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0" Spacing="3">
                            <TextBlock Text="Configuration" Foreground="{StaticResource AppMutedTextBrush}" />
                            <TextBlock Text="{Binding ConfigurationSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="1" Spacing="3">
                            <TextBlock Text="Load" Foreground="{StaticResource AppMutedTextBrush}" />
                            <TextBlock Text="{Binding LoadSummary}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

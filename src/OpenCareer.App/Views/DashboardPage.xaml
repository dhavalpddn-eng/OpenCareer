<Page
    x:Class="OpenCareer.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Margin="32" Spacing="20">
            <StackPanel Spacing="4">
                <TextBlock Text="Dashboard"
                           Style="{StaticResource OpenCareerPageTitleStyle}" />
                <TextBlock Text="Your career starts here. OpenCareer remains usable even when MSFS is not running."
                           Style="{StaticResource OpenCareerPageSubtitleStyle}" />
            </StackPanel>

            <Border Style="{StaticResource OpenCareerPaperCardStyle}"
                    Padding="28">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="10">
                        <TextBlock Text="SIMULATOR STATUS"
                                   Style="{StaticResource OpenCareerPaperEyebrowStyle}" />
                        <TextBlock Text="{Binding ConnectionStatus}"
                                   FontSize="24"
                                   Style="{StaticResource OpenCareerPaperTitleStyle}" />
                        <TextBlock Text="{Binding ConnectionDetail}"
                                   Style="{StaticResource OpenCareerPaperBodyStyle}"
                                   MaxWidth="700" />
                        <TextBlock Text="Flight tracking will become available in a later build."
                                   Style="{StaticResource OpenCareerPaperBodyStyle}"
                                   MaxWidth="700" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Style="{StaticResource OpenCareerPaperInsetStyle}"
                            Padding="18,12"
                            VerticalAlignment="Center">
                        <StackPanel Spacing="4">
                            <TextBlock Text="HOME BASE"
                                       Style="{StaticResource OpenCareerPaperEyebrowStyle}" />
                            <TextBlock Text="KRME"
                                       Style="{StaticResource OpenCareerPaperValueStyle}" />
                            <TextBlock Text="Griffiss International"
                                       Style="{StaticResource OpenCareerPaperBodyStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource OpenCareerPaperCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="CAREER STANDING"
                                   Style="{StaticResource OpenCareerPaperEyebrowStyle}" />
                        <TextBlock Text="New Pilot"
                                   Style="{StaticResource OpenCareerPaperTitleStyle}" />
                        <TextBlock Text="Qualifications, reputation and employer trust will drive access."
                                   Style="{StaticResource OpenCareerPaperBodyStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource OpenCareerPaperCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="CURRENT AIRCRAFT"
                                   Style="{StaticResource OpenCareerPaperEyebrowStyle}" />
                        <TextBlock Text="{Binding AircraftStatus}"
                                   Style="{StaticResource OpenCareerPaperTitleStyle}" />
                        <TextBlock Text="Employer, rented, assigned and owned aircraft stay distinct."
                                   Style="{StaticResource OpenCareerPaperBodyStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource OpenCareerPaperCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="NEXT STEP"
                                   Style="{StaticResource OpenCareerPaperEyebrowStyle}" />
                        <TextBlock Text="Connect to MSFS"
                                   Style="{StaticResource OpenCareerPaperTitleStyle}" />
                        <TextBlock Text="Live telemetry and flight-state detection come next."
                                   Style="{StaticResource OpenCareerPaperBodyStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>

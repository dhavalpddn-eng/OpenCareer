<Page
    x:Class="OpenCareer.App.Views.FinancesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Margin="32" Spacing="20">
            <StackPanel Spacing="4">
                <TextBlock
                    Text="Finances"
                    FontSize="30"
                    FontWeight="SemiBold" />
                <TextBlock
                    Text="Authoritative local cash ledger, contract settlement and career finance."
                    Foreground="{StaticResource AppMutedTextBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="22">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Text="AVAILABLE CASH"
                            Foreground="{StaticResource AppMutedTextBrush}"
                            FontSize="11" />
                        <TextBlock
                            Text="{Binding CashBalanceText}"
                            FontSize="32"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="Settled ledger balance. Quotes and uncompleted jobs are not counted."
                            Foreground="{StaticResource AppMutedTextBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="22">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Text="LEDGER STATUS"
                            Foreground="{StaticResource AppMutedTextBrush}"
                            FontSize="11" />
                        <TextBlock
                            Text="{Binding StatusText}"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource AppSuccessBrush}" />
                        <TextBlock
                            Text="{Binding StatusDetail}"
                            Foreground="{StaticResource AppMutedTextBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="22">
                <StackPanel Spacing="14">
                    <TextBlock
                        Text="Recent transactions"
                        FontSize="20"
                        FontWeight="SemiBold" />

                    <ListView
                        ItemsSource="{Binding RecentTransactions}"
                        IsItemClickEnabled="False"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    Padding="4,10"
                                    ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="3">
                                        <TextBlock
                                            Text="{Binding Description}"
                                            FontWeight="SemiBold"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Text="{Binding DateText}"
                                            Foreground="{StaticResource AppMutedTextBrush}"
                                            FontSize="12" />
                                        <TextBlock
                                            Text="{Binding ReferenceText}"
                                            Foreground="{StaticResource AppMutedTextBrush}"
                                            FontSize="11"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding AmountText}"
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Border
                Background="{StaticResource AppSurfaceAltBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18">
                <StackPanel Spacing="6">
                    <TextBlock
                        Text="Settlement rules"
                        FontWeight="SemiBold" />
                    <TextBlock
                        Text="Money is posted only after verified contract completion. Duplicate settlement attempts are idempotent and cannot pay the same contract twice."
                        Foreground="{StaticResource AppMutedTextBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="Market quotes, credit decisions and future loan offers are not cash until an authoritative transaction is posted."
                        Foreground="{StaticResource AppMutedTextBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

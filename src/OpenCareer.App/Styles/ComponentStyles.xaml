        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="90" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OpenCareerPaperTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkBrush}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OpenCareerPaperValueStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkBrush}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OpenCareerPaperBodyStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkMutedBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OpenCareerPaperDataLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OpenCareerPaperDataValueStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OpenCareerTableHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkMutedBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="70" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OpenCareerTableCellTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OpenCareerInputLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OpenCareerInputHelpStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Structural components -->
    <Style x:Key="OpenCareerPaperCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OpenCareerPaperBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerSteelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="RequestedTheme" Value="Light" />
    </Style>

    <Style x:Key="OpenCareerPaperInsetStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OpenCareerPaperAltBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerPaperRuleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="RequestedTheme" Value="Light" />
    </Style>

    <Style x:Key="OpenCareerMetalCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OpenCareerShellRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerSteelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="RequestedTheme" Value="Dark" />
    </Style>

    <Style x:Key="OpenCareerMetalInsetStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OpenCareerShellInsetBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerSteelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="RequestedTheme" Value="Dark" />
    </Style>

    <!--
        Buttons use explicit templates instead of runtime-injected native resource keys.
        The former attached-resource approach could be applied after the stock template had
        already resolved its theme resources, leaving button content unreadable until another
        theme/state transition. These templates make every visual state deterministic while
        retaining WinUI's system focus visual.
    -->
    <ControlTemplate x:Key="OpenCareerPrimaryButtonTemplate" TargetType="Button">
        <Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="ButtonBorder.Background" Value="{ThemeResource OpenCareerPrimaryButtonBackgroundPointerOver}" />
                            <Setter Target="ButtonBorder.BorderBrush" Value="{ThemeResource OpenCareerPrimaryButtonBorderPointerOver}" />
                            <Setter Target="ButtonContent.Foreground" Value="{ThemeResource OpenCareerPrimaryButtonForeground}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="ButtonBorder.Background" Value="{ThemeResource OpenCareerPrimaryButtonBackgroundPressed}" />
                            <Setter Target="ButtonBorder.BorderBrush" Value="{ThemeResource OpenCareerPrimaryButtonBorderPressed}" />
                            <Setter Target="ButtonContent.Foreground" Value="{ThemeResource OpenCareerPrimaryButtonForeground}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="ButtonBorder.Background" Value="{ThemeResource OpenCareerPrimaryButtonBackgroundDisabled}" />
                            <Setter Target="ButtonBorder.BorderBrush" Value="{ThemeResource OpenCareerPrimaryButtonBorderDisabled}" />
                            <Setter Target="ButtonContent.Foreground" Value="{ThemeResource OpenCareerPrimaryButtonForegroundDisabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                <ContentPresenter x:Name="ButtonContent"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Foreground="{TemplateBinding Foreground}"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="OpenCareerSecondaryButtonTemplate" TargetType="Button">
        <Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="ButtonBorder.Background" Value="{ThemeResource OpenCareerSecondaryButtonBackgroundPointerOver}" />
                            <Setter Target="ButtonBorder.BorderBrush" Value="{ThemeResource OpenCareerSecondaryButtonBorderPointerOver}" />
                            <Setter Target="ButtonContent.Foreground" Value="{ThemeResource OpenCareerSecondaryButtonForeground}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="ButtonBorder.Background" Value="{ThemeResource OpenCareerSecondaryButtonBackgroundPressed}" />
                            <Setter Target="ButtonBorder.BorderBrush" Value="{ThemeResource OpenCareerSecondaryButtonBorderPressed}" />
                            <Setter Target="ButtonContent.Foreground" Value="{ThemeResource OpenCareerSecondaryButtonForeground}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="ButtonBorder.Background" Value="{ThemeResource OpenCareerSecondaryButtonBackgroundDisabled}" />
                            <Setter Target="ButtonBorder.BorderBrush" Value="{ThemeResource OpenCareerSecondaryButtonBorderDisabled}" />
                            <Setter Target="ButtonContent.Foreground" Value="{ThemeResource OpenCareerSecondaryButtonForegroundDisabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                <ContentPresenter x:Name="ButtonContent"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Foreground="{TemplateBinding Foreground}"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="OpenCareerDangerButtonTemplate" TargetType="Button">
        <Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="ButtonBorder.Background" Value="{ThemeResource OpenCareerDangerButtonBackgroundPointerOver}" />
                            <Setter Target="ButtonBorder.BorderBrush" Value="{ThemeResource OpenCareerDangerButtonBorderPointerOver}" />
                            <Setter Target="ButtonContent.Foreground" Value="{ThemeResource OpenCareerDangerButtonForeground}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="ButtonBorder.Background" Value="{ThemeResource OpenCareerDangerButtonBackgroundPressed}" />
                            <Setter Target="ButtonBorder.BorderBrush" Value="{ThemeResource OpenCareerDangerButtonBorderPressed}" />
                            <Setter Target="ButtonContent.Foreground" Value="{ThemeResource OpenCareerDangerButtonForeground}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="ButtonBorder.Background" Value="{ThemeResource OpenCareerDangerButtonBackgroundDisabled}" />
                            <Setter Target="ButtonBorder.BorderBrush" Value="{ThemeResource OpenCareerDangerButtonBorderDisabled}" />
                            <Setter Target="ButtonContent.Foreground" Value="{ThemeResource OpenCareerDangerButtonForegroundDisabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                <ContentPresenter x:Name="ButtonContent"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Foreground="{TemplateBinding Foreground}"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
        </Grid>
    </ControlTemplate>

    <Style x:Key="OpenCareerButtonBaseStyle"
           TargetType="Button"
           BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource OpenCareerShellTextBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource OpenCareerNavyPressedBrush}" />
    </Style>

    <Style x:Key="OpenCareerPrimaryButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource OpenCareerButtonBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource OpenCareerPrimaryButtonBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource OpenCareerPrimaryButtonForeground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource OpenCareerPrimaryButtonBorder}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Template" Value="{StaticResource OpenCareerPrimaryButtonTemplate}" />
    </Style>

    <Style x:Key="OpenCareerSecondaryButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource OpenCareerButtonBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource OpenCareerSecondaryButtonBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource OpenCareerSecondaryButtonForeground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource OpenCareerSecondaryButtonBorder}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Template" Value="{StaticResource OpenCareerSecondaryButtonTemplate}" />
    </Style>

    <Style x:Key="OpenCareerDangerButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource OpenCareerButtonBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource OpenCareerDangerButtonBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource OpenCareerDangerButtonForeground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource OpenCareerDangerButtonBorder}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Template" Value="{StaticResource OpenCareerDangerButtonTemplate}" />
    </Style>

    <!-- Form controls: visual skin only; native WinUI interaction/focus templates remain intact. -->
    <Style x:Key="OpenCareerTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource OpenCareerPaperBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerPaperRuleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="RequestedTheme" Value="Light" />

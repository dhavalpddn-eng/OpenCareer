<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Typography: shell -->
    <Style x:Key="OpenCareerPageTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerShellTextBrush}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="20" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OpenCareerPageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerShellMutedTextBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OpenCareerShellSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerShellTextBrush}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OpenCareerShellBodyStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerShellMutedTextBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Typography: briefing paper -->
    <Style x:Key="OpenCareerPaperEyebrowStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkMutedBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="90" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OpenCareerPaperTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkBrush}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OpenCareerPaperValueStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkBrush}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OpenCareerPaperBodyStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkMutedBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OpenCareerPaperDataLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OpenCareerPaperDataValueStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Structural components -->
    <Style x:Key="OpenCareerPaperCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OpenCareerPaperBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerSteelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="RequestedTheme" Value="Light" />
    </Style>

    <Style x:Key="OpenCareerPaperInsetStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OpenCareerPaperAltBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerPaperRuleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="RequestedTheme" Value="Light" />
    </Style>

    <Style x:Key="OpenCareerMetalCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OpenCareerShellRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerSteelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="RequestedTheme" Value="Dark" />
    </Style>

    <Style x:Key="OpenCareerMetalInsetStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OpenCareerShellInsetBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerSteelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="RequestedTheme" Value="Dark" />
    </Style>

    <!-- Buttons -->
    <Style x:Key="OpenCareerPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource OpenCareerNavyBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OpenCareerShellTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerSteelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="OpenCareerSecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource OpenCareerPaperAltBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerPaperRuleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="OpenCareerDangerButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource OpenCareerDangerBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OpenCareerShellTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerDangerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Status badges -->
    <Style x:Key="OpenCareerStatusBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OpenCareerPaperMutedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerPaperRuleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="RequestedTheme" Value="Light" />
    </Style>

    <Style x:Key="OpenCareerStatusBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="60" />
    </Style>
</ResourceDictionary>

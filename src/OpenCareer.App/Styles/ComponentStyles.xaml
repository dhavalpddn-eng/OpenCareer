        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerPaperRuleBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="RequestedTheme" Value="Light" />
    </Style>

    <Style x:Key="OpenCareerTableAlternateRowStyle"
           TargetType="Border"
           BasedOn="{StaticResource OpenCareerTableRowStyle}">
        <Setter Property="Background" Value="{StaticResource OpenCareerPaperAltBrush}" />
    </Style>

    <Style x:Key="OpenCareerTableSelectedRowStyle"
           TargetType="Border"
           BasedOn="{StaticResource OpenCareerTableRowStyle}">
        <Setter Property="Background" Value="{StaticResource OpenCareerSelectionBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerNavyBrush}" />
    </Style>


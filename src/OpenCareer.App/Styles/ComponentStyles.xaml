    <Style x:Key="OpenCareerToggleSwitchStyle" TargetType="ToggleSwitch">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkBrush}" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="RequestedTheme" Value="Light" />
    </Style>

    <!-- Tabs retain ToggleButton's checked/focus states while matching the document-tab footprint. -->
    <Style x:Key="OpenCareerTabStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{StaticResource OpenCareerPaperAltBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerPaperRuleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4,4,0,0" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="RequestedTheme" Value="Light" />
    </Style>

    <!-- Lists -->
    <Style x:Key="OpenCareerListViewStyle" TargetType="ListView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="RequestedTheme" Value="Light" />
    </Style>

    <Style x:Key="OpenCareerListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="RequestedTheme" Value="Light" />

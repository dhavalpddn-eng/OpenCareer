        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerSuccessBrush}" />
    </Style>

    <Style x:Key="OpenCareerWarningBadgeStyle"
           TargetType="Border"
           BasedOn="{StaticResource OpenCareerStatusBadgeStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerWarningBrush}" />
    </Style>

    <Style x:Key="OpenCareerDangerBadgeStyle"
           TargetType="Border"
           BasedOn="{StaticResource OpenCareerStatusBadgeStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerDangerBrush}" />
    </Style>

    <Style x:Key="OpenCareerUnavailableBadgeStyle"
           TargetType="Border"
           BasedOn="{StaticResource OpenCareerStatusBadgeStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerDisabledBrush}" />
    </Style>

    <Style x:Key="OpenCareerStatusBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OpenCareerSuccessTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource OpenCareerStatusBadgeTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerSuccessBrush}" />
    </Style>

    <Style x:Key="OpenCareerWarningTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource OpenCareerStatusBadgeTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerWarningBrush}" />
    </Style>

    <Style x:Key="OpenCareerDangerTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource OpenCareerStatusBadgeTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerDangerBrush}" />
    </Style>

    <Style x:Key="OpenCareerUnavailableTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource OpenCareerStatusBadgeTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerDisabledBrush}" />
    </Style>
</ResourceDictionary>

    <!-- Table/ledger building blocks for Grid-based production tables. -->
    <Style x:Key="OpenCareerTableHeaderRowStyle"
           TargetType="Border"
           BasedOn="{StaticResource OpenCareerPaperInsetStyle}">
        <Setter Property="CornerRadius" Value="3,3,0,0" />

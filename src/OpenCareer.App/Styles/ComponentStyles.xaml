<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Reusable OpenCareer visual components.
        Keep standard WinUI templates intact so keyboard focus, high contrast and accessibility
        behavior continue to come from the platform.
    -->

    <!-- Typography: shell -->
    <Style x:Key="OpenCareerPageTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerShellTextBrush}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="20" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OpenCareerPageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerShellMutedTextBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OpenCareerShellSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerShellTextBrush}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OpenCareerShellBodyStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerShellMutedTextBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Typography: briefing paper -->
    <Style x:Key="OpenCareerPaperEyebrowStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkMutedBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="90" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OpenCareerPaperTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkBrush}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OpenCareerPaperValueStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkBrush}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OpenCareerPaperBodyStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkMutedBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OpenCareerPaperDataLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OpenCareerPaperDataValueStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OpenCareerTableHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkMutedBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="70" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OpenCareerTableCellTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OpenCareerInputLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OpenCareerInputHelpStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Structural components -->
    <Style x:Key="OpenCareerPaperCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OpenCareerPaperBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerSteelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="RequestedTheme" Value="Light" />
    </Style>

    <Style x:Key="OpenCareerPaperInsetStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OpenCareerPaperAltBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerPaperRuleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="RequestedTheme" Value="Light" />
    </Style>

    <Style x:Key="OpenCareerMetalCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OpenCareerShellRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerSteelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="RequestedTheme" Value="Dark" />
    </Style>

    <Style x:Key="OpenCareerMetalInsetStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OpenCareerShellInsetBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerSteelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="RequestedTheme" Value="Dark" />
    </Style>

    <!-- Buttons: preserve the platform template/focus visuals. -->
    <Style x:Key="OpenCareerButtonBaseStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="OpenCareerPrimaryButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource OpenCareerButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource OpenCareerNavyBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OpenCareerShellTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerSteelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RequestedTheme" Value="Dark" />
    </Style>

    <Style x:Key="OpenCareerSecondaryButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource OpenCareerButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource OpenCareerPaperAltBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerPaperRuleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RequestedTheme" Value="Light" />
    </Style>

    <Style x:Key="OpenCareerDangerButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource OpenCareerButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource OpenCareerDangerBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OpenCareerShellTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerDangerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RequestedTheme" Value="Dark" />
    </Style>

    <!-- Form controls: visual skin only; native WinUI interaction/focus templates remain intact. -->
    <Style x:Key="OpenCareerTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource OpenCareerPaperBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerPaperRuleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="RequestedTheme" Value="Light" />
    </Style>

    <Style x:Key="OpenCareerComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource OpenCareerPaperBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerPaperRuleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="RequestedTheme" Value="Light" />
    </Style>

    <Style x:Key="OpenCareerCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkBrush}" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="RequestedTheme" Value="Light" />
    </Style>

    <Style x:Key="OpenCareerToggleSwitchStyle" TargetType="ToggleSwitch">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkBrush}" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="RequestedTheme" Value="Light" />
    </Style>

    <!-- Tabs retain ToggleButton's checked/focus states while matching the document-tab footprint. -->
    <Style x:Key="OpenCareerTabStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{StaticResource OpenCareerPaperAltBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerPaperRuleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4,4,0,0" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="RequestedTheme" Value="Light" />
    </Style>

    <!-- Lists -->
    <Style x:Key="OpenCareerListViewStyle" TargetType="ListView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="RequestedTheme" Value="Light" />
    </Style>

    <Style x:Key="OpenCareerListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="RequestedTheme" Value="Light" />
    </Style>

    <!-- Table/ledger building blocks for Grid-based production tables. -->
    <Style x:Key="OpenCareerTableHeaderRowStyle"
           TargetType="Border"
           BasedOn="{StaticResource OpenCareerPaperInsetStyle}">
        <Setter Property="CornerRadius" Value="3,3,0,0" />
        <Setter Property="Padding" Value="12,9" />
    </Style>

    <Style x:Key="OpenCareerTableRowStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OpenCareerPaperBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerPaperRuleBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="RequestedTheme" Value="Light" />
    </Style>

    <Style x:Key="OpenCareerTableAlternateRowStyle"
           TargetType="Border"
           BasedOn="{StaticResource OpenCareerTableRowStyle}">
        <Setter Property="Background" Value="{StaticResource OpenCareerPaperAltBrush}" />
    </Style>

    <Style x:Key="OpenCareerTableSelectedRowStyle"
           TargetType="Border"
           BasedOn="{StaticResource OpenCareerTableRowStyle}">
        <Setter Property="Background" Value="{StaticResource OpenCareerSelectionBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerNavyBrush}" />
    </Style>

    <!-- Status badges: semantic color is paired with text by consumers. -->
    <Style x:Key="OpenCareerStatusBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OpenCareerPaperMutedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerPaperRuleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="RequestedTheme" Value="Light" />
    </Style>

    <Style x:Key="OpenCareerSuccessBadgeStyle"
           TargetType="Border"
           BasedOn="{StaticResource OpenCareerStatusBadgeStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerSuccessBrush}" />
    </Style>

    <Style x:Key="OpenCareerWarningBadgeStyle"
           TargetType="Border"
           BasedOn="{StaticResource OpenCareerStatusBadgeStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerWarningBrush}" />
    </Style>

    <Style x:Key="OpenCareerDangerBadgeStyle"
           TargetType="Border"
           BasedOn="{StaticResource OpenCareerStatusBadgeStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerDangerBrush}" />
    </Style>

    <Style x:Key="OpenCareerUnavailableBadgeStyle"
           TargetType="Border"
           BasedOn="{StaticResource OpenCareerStatusBadgeStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource OpenCareerDisabledBrush}" />
    </Style>

    <Style x:Key="OpenCareerStatusBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerInkBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OpenCareerSuccessTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource OpenCareerStatusBadgeTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerSuccessBrush}" />
    </Style>

    <Style x:Key="OpenCareerWarningTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource OpenCareerStatusBadgeTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerWarningBrush}" />
    </Style>

    <Style x:Key="OpenCareerDangerTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource OpenCareerStatusBadgeTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerDangerBrush}" />
    </Style>

    <Style x:Key="OpenCareerUnavailableTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource OpenCareerStatusBadgeTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource OpenCareerDisabledBrush}" />
    </Style>
</ResourceDictionary>

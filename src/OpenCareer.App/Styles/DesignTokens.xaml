            <StaticResource x:Key="OpenCareerSecondaryButtonForeground" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="OpenCareerSecondaryButtonForegroundDisabled" ResourceKey="SystemControlDisabledBaseMediumLowBrush" />
            <StaticResource x:Key="OpenCareerSecondaryButtonBorder" ResourceKey="SystemColorButtonTextColorBrush" />

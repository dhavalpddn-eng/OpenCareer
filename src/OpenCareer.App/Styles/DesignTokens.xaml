    <!--
        OpenCareer Jet Age palette.
        Canonical direction: cool dark aircraft/operations framing + vivid ivory briefing paper.
        These tokens intentionally avoid the earlier olive/yellow/sepia drift.
    -->

    <Color x:Key="OpenCareerShellBackgroundColor">#111C26</Color>
    <Color x:Key="OpenCareerShellRaisedColor">#192A37</Color>
    <Color x:Key="OpenCareerShellInsetColor">#223846</Color>
    <Color x:Key="OpenCareerSteelBorderColor">#405867</Color>
    <Color x:Key="OpenCareerSteelHighlightColor">#6E818D</Color>

    <Color x:Key="OpenCareerShellTextColor">#FFFDF8</Color>
    <Color x:Key="OpenCareerShellMutedTextColor">#B7C3C9</Color>

    <Color x:Key="OpenCareerPaperColor">#FFFDF8</Color>
    <Color x:Key="OpenCareerPaperAltColor">#F5F2E9</Color>
    <Color x:Key="OpenCareerPaperMutedColor">#E9E5DA</Color>
    <Color x:Key="OpenCareerInkColor">#18252D</Color>
    <Color x:Key="OpenCareerInkMutedColor">#5C6870</Color>
    <Color x:Key="OpenCareerPaperRuleColor">#C8C1B4</Color>

    <Color x:Key="OpenCareerNavyColor">#29475C</Color>
    <Color x:Key="OpenCareerNavyRaisedColor">#365E77</Color>
    <Color x:Key="OpenCareerNavyPressedColor">#1E384A</Color>
    <Color x:Key="OpenCareerSecondaryPressedColor">#829DAC</Color>
    <Color x:Key="OpenCareerSelectionColor">#9FB7C7</Color>
    <Color x:Key="OpenCareerBrassColor">#B58A48</Color>

    <Color x:Key="OpenCareerSuccessColor">#3E7E57</Color>
    <Color x:Key="OpenCareerWarningColor">#C58327</Color>
    <Color x:Key="OpenCareerDangerColor">#B8453E</Color>
    <Color x:Key="OpenCareerDangerRaisedColor">#C04B44</Color>
    <Color x:Key="OpenCareerDangerPressedColor">#8F302B</Color>
    <Color x:Key="OpenCareerDangerDisabledColor">#6B6261</Color>
    <Color x:Key="OpenCareerDisabledColor">#7B878E</Color>
    <Color x:Key="OpenCareerTutorialScrimColor">#B30A1118</Color>

    <Color x:Key="OpenCareerOpportunityStandardColor">#3E7E57</Color>
    <Color x:Key="OpenCareerOpportunitySpecialistColor">#4D78A8</Color>
    <Color x:Key="OpenCareerOpportunityEliteColor">#7456A8</Color>
    <Color x:Key="OpenCareerOpportunityLegendaryColor">#C47A2C</Color>

    <SolidColorBrush x:Key="OpenCareerShellBackgroundBrush" Color="{StaticResource OpenCareerShellBackgroundColor}" />
    <SolidColorBrush x:Key="OpenCareerShellRaisedBrush" Color="{StaticResource OpenCareerShellRaisedColor}" />
    <SolidColorBrush x:Key="OpenCareerShellInsetBrush" Color="{StaticResource OpenCareerShellInsetColor}" />
    <SolidColorBrush x:Key="OpenCareerSteelBorderBrush" Color="{StaticResource OpenCareerSteelBorderColor}" />

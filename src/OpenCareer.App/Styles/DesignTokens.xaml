            <StaticResource x:Key="OpenCareerPrimaryButtonBackgroundDisabled" ResourceKey="SystemControlBackgroundBaseLowBrush" />
            <StaticResource x:Key="OpenCareerPrimaryButtonForeground" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="OpenCareerPrimaryButtonForegroundDisabled" ResourceKey="SystemControlDisabledBaseMediumLowBrush" />
            <StaticResource x:Key="OpenCareerPrimaryButtonBorder" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="OpenCareerPrimaryButtonBorderPointerOver" ResourceKey="SystemColorHighlightTextColorBrush" />
            <StaticResource x:Key="OpenCareerPrimaryButtonBorderPressed" ResourceKey="SystemColorHighlightTextColorBrush" />
            <StaticResource x:Key="OpenCareerPrimaryButtonBorderDisabled" ResourceKey="SystemControlDisabledBaseMediumLowBrush" />

            <StaticResource x:Key="OpenCareerSecondaryButtonBackground" ResourceKey="SystemControlBackgroundBaseLowBrush" />
